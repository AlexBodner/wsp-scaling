{"turn": 2, "prompt_bytes": 21996, "reply": "```python\nimport numpy as np\nimport pandas as pd\nfrom threadpoolctl import threadpool_limits\nthreadpool_limits(limits=4)\n\nheads = {}\nfor l in range(12):\n    A = np.asarray(W[f\"L{l}.qkv.W\"], dtype=np.float64)\n    g = np.asarray(W[f\"L{l}.norm1.scale\"], dtype=np.float64)\n    b = np.asarray(W[f\"L{l}.norm1.shift\"], dtype=np.float64)\n    B = g[:, None] * A\n    B -= B.mean(axis=0, keepdims=True)\n    bias = b @ A + np.asarray(W[f\"L{l}.qkv.b\"], dtype=np.float64)\n    for h in range(12):\n        Q = B[:, 64*h:64*(h+1)]\n        K = B[:, 768+64*h:768+64*(h+1)]\n        r = K @ bias[64*h:64*(h+1)] / 8\n        norm = np.sqrt(np.sum((Q.T @ Q)*(K.T @ K))) / 8\n        heads[f\"{l}.{h}\"] = (Q, K, r, norm)\n\nselected = [\n    \"0.11\", \"1.0\", \"1.3\", \"1.4\", \"1.5\", \"1.7\", \"1.8\", \"1.11\",\n    \"2.0\", \"2.2\", \"2.3\", \"2.4\", \"2.5\", \"2.6\", \"2.7\", \"2.8\",\n    \"2.10\", \"2.11\", \"4.9\", \"8.2\", \"9.3\", \"9.8\", \"10.8\", \"10.11\"\n]\nmatrices = []\nsvds = {}\nprint(\"Leading singular values of QK products:\")\nfor name in selected:\n    Q, K, r, norm = heads[name]\n    uq, rq = np.linalg.qr(Q, mode=\"reduced\")\n    uk, rk = np.linalg.qr(K, mode=\"reduced\")\n    u, s, vt = np.linalg.svd(rq @ rk.T / 8, full_matrices=False)\n    U, V = uq @ u, uk @ vt.T\n    svds[name] = (U, s, V)\n    matrices.append((Q @ K.T / 8).ravel())\n    print(name, np.round(s[:8], 4), \"bias norm\", round(np.linalg.norm(r), 4))\n\nM = np.stack(matrices)\ncos = (M @ M.T) / (np.linalg.norm(M, axis=1)[:, None]\n                       * np.linalg.norm(M, axis=1)[None, :])\npairs = []\nfor i in range(len(selected)):\n    for j in range(i):\n        pairs.append((selected[j], selected[i], cos[i,j]))\nprint(\"\\nLargest absolute pairwise QK-product correlations:\")\nfor a, b, c in sorted(pairs, key=lambda t: -abs(t[2]))[:50]:\n    print(a, b, round(c, 4))\n\ncore = [\"2.3\", \"2.4\", \"2.5\", \"2.10\", \"2.11\"]\ncolumns =